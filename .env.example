# JIRA Configuration for AIDemoTest Project
# Copy this file to .env and fill in your actual values

# JIRA Instance Configuration
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_USERNAME=your-email@company.com
JIRA_API_TOKEN=your-api-token-here

# GitHub Integration (optional)
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret

# Salesforce Integration (optional)
SALESFORCE_WEBHOOK_SECRET=your-salesforce-webhook-secret

# Instructions:
# 1. Go to https://id.atlassian.com/manage-profile/security/api-tokens
# 2. Create a new API token
# 3. Copy the token and paste it as JIRA_API_TOKEN value
# 4. Update JIRA_BASE_URL with your actual JIRA domain
# 5. Update JIRA_USERNAME with your email address
